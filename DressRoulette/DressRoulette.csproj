<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <!-- Champs du manifeste (voir https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Lénile</Author>
    <Name>DressRoulette</Name>
    <Punchline>A daily glamour theme, the same for everyone. Dress up, share with #DressRoulette.</Punchline>
    <Description>DressRoulette gives you one glamour theme per day, the same for every player, changing at the daily reset.
Build your outfit around it, then share it with #DressRoulette.

- Daily theme and an optional bonus constraint
- Free wheel to spin as often as you like, with your own themes
- Sharing streak, best streak, streak-saving jokers and a calendar of your last days
- Optional reminder of today's theme in your chat (only you can see it)
- French and English

DressRoulette never changes your outfit and sends nothing over the internet. The share button only copies a text to your clipboard and opens a Discord channel in your browser.

AI disclosure: the English translations were made with AI assistance. The icon was made by hand, without AI.</Description>
    <RepoUrl>https://github.com/Lenile/DressRoulette</RepoUrl>
    <Tags>glamour;fashion;outfit;roleplay;daily;challenge</Tags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Données des thèmes et contraintes, intégrées dans la DLL -->
    <EmbeddedResource Include="Data\themes.json" LogicalName="DressRoulette.Data.themes.json" />
    <EmbeddedResource Include="Data\constraints.json" LogicalName="DressRoulette.Data.constraints.json" />
  </ItemGroup>

</Project>
